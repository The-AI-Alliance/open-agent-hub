{% if include.id %}
  {% assign feature_row = page[include.id] %}
{% else %}
  {% assign feature_row = page.feature_row %}
{% endif %}

<div class="feature__wrapper">

  {% for f in feature_row %}
    <div class="feature__item{% if include.type %}--{{ include.type }}{% endif %}">

      <div class="archive__item">
        {% if f.image_path %}
          {% if f.website %}
            {% assign url = f.website.url %}
          {% elsif f.repo %}
            {% assign url = f.repo.url %}
          {% else %}
            {% assign url = relative_url %}
          {% endif %}
          <div class="archive__item-teaser">
            <a href="{{ url }}" class="btn no-glyph" target="{{ f.alt | "_blank" }}"><img
              src="{{ f.image_path | relative_url }}"
                 alt="{% if f.alt %}{{ f.alt }}{% endif %}"></a>
            {% if f.image_caption %}
              <span class="archive__item-caption">{{ f.image_caption | markdownify | remove: "<p>" | remove: "</p>" }}</span>
            {% endif %}
          </div>
        {% endif %}

        <div class="archive__item-body">
          {% if f.title %}
            <h2 class="archive__item-title">{{ f.title }} {% if f.core_project %}<img src="{{site.baseurl}}/assets/images/favicon-16x16.png" alt="AI Alliance Core Project"/>{% endif %}</h2>
          {% endif %}

          {% if f.tags %}
            {% for tag in f.tags %}<span class="archive__item-tag tag {{ page.tag_class }}">{{ tag }}</span> {% endfor %}
          {% endif %}

          {% if f.excerpt %}
            <div class="archive__item-excerpt">
              {{ f.excerpt | markdownify }}
            </div>
          {% endif %}

          <p>
            {% if f.website %}<a href="{{ f.website.url }}" class="btn {{ page.btn_class }} no-glyph" target="{{ f.alt | "_blank" }}{{ f.website.label" | "" }}">{{ f.website.label | default: "Website" }}</a>{% endif %}
            {% if f.repo %}<a href="{{ f.repo.url }}" class="btn {{ page.btn_class }} no-glyph" target="{{ f.alt | "_blank" }}{{ f.repo.label" | "" }}">{{ f.repo.label | default: "Website" }}</a>{% endif %}
          </p>
        </div>
      </div>
    </div>
  {% endfor %}

</div>
